# Copy to .env and adjust. Never commit real credentials.

# --- PostgreSQL ---
POSTGRES_DB=uni_shortlist
POSTGRES_USER=uni_shortlist
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://uni_shortlist:change_me_local_only@db:5432/uni_shortlist
APP_DB_USER=uni_shortlist_app
APP_DB_PASSWORD=change_me_app_local_only
APP_DATABASE_URL=postgresql+psycopg://uni_shortlist_app:change_me_app_local_only@db:5432/uni_shortlist

# Isolated Compose test stack (provide a unique, untracked secret in your shell/.env).
# TEST_DB_PASSWORD=generate_a_unique_test_only_secret
# RECOVERY_DB_PASSWORD=generate_a_different_recovery_only_secret
# TEST_WEB_PORT=8081

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# local | production
ENVIRONMENT=local
# MIGRATION_TARGET and SEED_TARGET are supplied explicitly to one-off commands only.
# Include demo accounts when the explicit seed command is run (local only)
SEED_DEMO_DATA=true

# --- Frontend (Vite)---
# API base path the SPA calls (proxied by NGINX/vite dev proxy)
VITE_API_BASE=/api/v1
# Host port for the NGINX container (override if 8080 is reserved by the OS)
WEB_PORT=8080

# In-process background scheduler for refresh jobs (APScheduler; no Redis)
ENABLE_SCHEDULER=false

# --- Data ingestion ---
# Contact address included in the polite User-Agent sent to public data sources
INGESTION_CONTACT=admin@example.com
# Where downloaded public-domain source files are cached (never committed)
INGESTION_CACHE_DIR=./.ingestion_cache
IPEDS_HD_RELEASE_YEAR=2024
IPEDS_IC_RELEASE_YEAR=2023
