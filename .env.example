# Copy to .env and adjust. Never commit real credentials.

# --- PostgreSQL ---
POSTGRES_DB=uni_shortlist
POSTGRES_USER=uni_shortlist
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://uni_shortlist:change_me_local_only@db:5432/uni_shortlist

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# local | production
ENVIRONMENT=local
# Seed demo account roles on startup (local only)
SEED_DEMO_DATA=true

# --- Frontend (Vite)---
VITE_API_BASE_URL=/api/v1
